# Copy to .env for local development. DATABASE_URL* are filled in by `neon env pull`.
# In production, set the database secret with: npx wrangler secret put DATABASE_URL  (the pooled URL)
MYSPACE_ORIGIN=http://localhost:3000
# Signs Better Auth cookies. Generate with: openssl rand -base64 32
# In production: npx wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=
# Pooled for the app, unpooled (direct) for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Object storage (wishlist images), filled in by `neon deploy` / `neon env pull`.
# In production: npx wrangler secret put <NAME> for each of these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
