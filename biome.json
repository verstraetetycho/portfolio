{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.js",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/global/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/common/**", "**/domains/**", "**/routes/**"],
										"message": "global/ is app-wide and may not import common/, domains/ or routes/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/common/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/domains/**", "**/routes/**"],
										"message": "common/ may only import global/. Code used by one domain belongs in that domain."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/domains/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/domains/**", "**/routes/**", "../**"],
										"message": "A domain may only import common/, global/ and its own files (./). Shared code goes to common/."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
